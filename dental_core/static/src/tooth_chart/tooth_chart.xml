<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dental_core.DentalToothChart">
        <div class="o_dental_chart" dir="ltr">
            <t t-foreach="rows()" t-as="row" t-key="row.key">
                <div t-attf-class="o_dental_row o_dental_row_{{row.key}}">
                    <t t-foreach="row.teeth" t-as="code" t-key="code">
                        <div t-att-class="toothClass(code)" t-att-title="toothTitle(code)">
                            <span class="o_dental_code" t-esc="code"/>
                            <span class="o_dental_surfaces" t-if="toothInfo(code) and toothInfo(code).surfaces"
                                  t-esc="toothInfo(code).surfaces"/>
                        </div>
                    </t>
                </div>
            </t>
            <div class="o_dental_legend">
                <t t-foreach="legend" t-as="item" t-key="item[0]">
                    <span class="o_dental_legend_item">
                        <span t-attf-class="o_dental_swatch o_dental_tooth_{{item[0]}}"/>
                        <t t-esc="item[1]"/>
                    </span>
                </t>
            </div>
        </div>
    </t>
</templates>
