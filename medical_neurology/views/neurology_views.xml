<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_visit_form_neurology" model="ir.ui.view">
        <field name="name">medical.visit.form.neurology</field>
        <field name="model">medical.visit</field>
        <field name="inherit_id" ref="medical_core.medical_visit_view_form"/>
        <field name="arch" type="xml">
            <field name="visit_type" position="after">
                <field name="is_neuro" invisible="1"/>
            </field>
            <xpath expr="//page[@name='consultation']" position="after">
                <page string="Neuro Exam" name="neuro_exam" invisible="not is_neuro" groups="medical_core.group_medical_doctor">
                    <div class="alert alert-warning" role="alert" invisible="not neuro_focal_deficit">
                        <i class="fa fa-exclamation-triangle me-1" title="Focal deficit"/>
                        <strong>Focal deficit: </strong><field name="neuro_findings" class="d-inline"/>
                        <field name="neuro_focal_deficit" invisible="1"/>
                    </div>
                    <group>
                        <group string="Mental Status">
                            <field name="neuro_consciousness"/>
                            <field name="neuro_orientation"/>
                            <field name="neuro_speech"/>
                            <field name="neuro_meningism"/>
                        </group>
                        <group string="Cranial Nerves">
                            <field name="neuro_cranial_nerves"/>
                            <field name="neuro_cranial_note" invisible="neuro_cranial_nerves != 'abnormal'"/>
                        </group>
                    </group>
                    <group string="Motor (MRC 0-5) and Reflexes">
                        <group string="Right">
                            <field name="neuro_power_rul" string="Arm power"/>
                            <field name="neuro_power_rll" string="Leg power"/>
                            <field name="neuro_reflex_ru" string="Arm reflexes"/>
                            <field name="neuro_reflex_rl" string="Leg reflexes"/>
                            <field name="neuro_plantar_r" string="Plantar"/>
                        </group>
                        <group string="Left">
                            <field name="neuro_power_lul" string="Arm power"/>
                            <field name="neuro_power_lll" string="Leg power"/>
                            <field name="neuro_reflex_lu" string="Arm reflexes"/>
                            <field name="neuro_reflex_ll" string="Leg reflexes"/>
                            <field name="neuro_plantar_l" string="Plantar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tone &amp; Sensation">
                            <field name="neuro_tone"/>
                            <field name="neuro_sensation"/>
                            <field name="neuro_sensation_note" invisible="neuro_sensation in (False, 'normal')"/>
                        </group>
                        <group string="Coordination &amp; Gait">
                            <field name="neuro_coordination"/>
                            <field name="neuro_gait"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_form_neurology" model="ir.ui.view">
        <field name="name">res.partner.form.neurology</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="medical_core.res_partner_form_medical"/>
        <field name="arch" type="xml">
            <page name="measurements" position="after">
                <page string="Seizure &amp; Headache Diary" name="neuro_diary" invisible="not is_patient"
                      groups="medical_core.group_medical_nurse">
                    <group>
                        <group>
                            <field name="last_seizure_date"/>
                            <field name="seizure_free_days" invisible="not last_seizure_date"/>
                        </group>
                        <group>
                            <field name="seizures_90d"/>
                            <field name="headache_days_30d"/>
                        </group>
                    </group>
                    <field name="neuro_event_ids" context="{'default_patient_id': id}">
                        <list editable="top" limit="15">
                            <field name="date"/>
                            <field name="event_type"/>
                            <field name="seizure_type" invisible="event_type != 'seizure'"/>
                            <field name="duration_min"/>
                            <field name="severity" invisible="event_type != 'headache'"/>
                            <field name="aura" optional="show"/>
                            <field name="triggers" optional="show"/>
                            <field name="rescue_medication" optional="hide"/>
                            <field name="emergency_visit" optional="hide"/>
                            <field name="reported_by" optional="hide"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="medical_neuro_event_view_list" model="ir.ui.view">
        <field name="name">medical.neuro.event.list</field>
        <field name="model">medical.neuro.event</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date"/>
                <field name="patient_id"/>
                <field name="event_type"/>
                <field name="seizure_type"/>
                <field name="duration_min"/>
                <field name="severity"/>
                <field name="triggers" optional="show"/>
                <field name="emergency_visit" optional="show"/>
            </list>
        </field>
    </record>

    <record id="medical_neuro_event_view_graph" model="ir.ui.view">
        <field name="name">medical.neuro.event.graph</field>
        <field name="model">medical.neuro.event</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="0">
                <field name="date" interval="month"/>
                <field name="event_type"/>
            </graph>
        </field>
    </record>

    <record id="medical_neuro_event_view_search" model="ir.ui.view">
        <field name="name">medical.neuro.event.search</field>
        <field name="model">medical.neuro.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <filter name="seizures" string="Seizures" domain="[('event_type', '=', 'seizure')]"/>
                <filter name="headaches" string="Headaches" domain="[('event_type', '=', 'headache')]"/>
                <filter name="emergency" string="Went to Emergency" domain="[('emergency_visit', '=', True)]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medical_neuro_event" model="ir.actions.act_window">
        <field name="name">Seizure &amp; Headache Diary</field>
        <field name="res_model">medical.neuro.event</field>
        <field name="view_mode">list,graph</field>
    </record>

    <record id="action_neurology_visit" model="ir.actions.act_window">
        <field name="name">Neurology Schedule</field>
        <field name="res_model">medical.visit</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="domain" eval="[('department_id', '=', ref('dept_neurology'))]"/>
        <field name="context" eval="{'default_department_id': ref('dept_neurology')}"/>
    </record>

    <record id="action_neurology_studies" model="ir.actions.act_window">
        <field name="name">EEG / EMG / NCS Studies</field>
        <field name="res_model">medical.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('order_type', '=', 'test'), ('line_ids.product_id.specialty_id.department_id', '=', ref('dept_neurology'))]"/>
        <field name="context" eval="{'default_order_type': 'test', 'search_default_pending': 1}"/>
    </record>

    <menuitem id="menu_neurology" name="Neurology" parent="medical_core.menu_medical_clinics" sequence="30"/>
    <menuitem id="menu_neurology_visit" name="Schedule" parent="menu_neurology" action="action_neurology_visit" sequence="5"/>
    <menuitem id="menu_neurology_studies" name="EEG / EMG / NCS Studies" parent="menu_neurology" action="action_neurology_studies" sequence="10"/>
    <menuitem id="menu_neuro_event" name="Seizure &amp; Headache Diary" parent="menu_neurology" action="action_medical_neuro_event"
              sequence="20" groups="medical_core.group_medical_nurse"/>
</odoo>
