<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_claim_line_form_ai" model="ir.ui.view">
        <field name="name">medical.claim.line.form.ai</field>
        <field name="model">medical.claim.line</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_scrub" type="object" string="Check Risk" invisible="state not in ('to_claim', 'claimed')"/>
                    <button name="action_draft_appeal" type="object" string="Draft Appeal Letter" class="btn-primary"
                            invisible="state not in ('rejected', 'partially_approved')"/>
                    <button name="action_resubmit" type="object" string="Resubmit"
                            invisible="state not in ('rejected', 'partially_approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_claim,claimed,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" readonly="1"/>
                            <field name="member_no" readonly="1"/>
                            <field name="insurer_id" readonly="1"/>
                            <field name="claim_id" readonly="1"/>
                            <field name="service_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="site_label" readonly="1"/>
                            <field name="approval_no"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="claimed" readonly="1"/>
                            <field name="approved" readonly="1"/>
                            <field name="reject_reason" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rejection Risk" invisible="not risk_level">
                        <group>
                            <field name="risk_score"/>
                            <field name="risk_level" widget="badge" decoration-danger="risk_level == 'high'"
                                   decoration-warning="risk_level == 'medium'" decoration-success="risk_level == 'low'"/>
                            <field name="risk_checked_at"/>
                        </group>
                        <field name="risk_reasons" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Appeal Letter" invisible="state not in ('rejected', 'partially_approved', 'resubmitted')">
                        <field name="appeal_text" nolabel="1" colspan="2" placeholder="Use 'Draft Appeal Letter', then edit and send."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_claim_line_list_ai" model="ir.ui.view">
        <field name="name">medical.claim.line.list.ai</field>
        <field name="model">medical.claim.line</field>
        <field name="inherit_id" ref="medical_insurance.medical_claim_line_view_list"/>
        <field name="arch" type="xml">
            <field name="claimed" position="before">
                <field name="risk_score" optional="show" invisible="not risk_level"/>
                <field name="risk_level" optional="show" widget="badge" decoration-danger="risk_level == 'high'"
                       decoration-warning="risk_level == 'medium'" decoration-success="risk_level == 'low'"/>
                <field name="risk_reasons" optional="hide"/>
            </field>
            <button name="action_resubmit" position="before">
                <button name="action_draft_appeal" type="object" string="Appeal" class="btn-link"
                        invisible="state not in ('rejected', 'partially_approved')"/>
            </button>
        </field>
    </record>

    <record id="medical_claim_line_search_ai" model="ir.ui.view">
        <field name="name">medical.claim.line.search.ai</field>
        <field name="model">medical.claim.line</field>
        <field name="inherit_id" ref="medical_insurance.medical_claim_line_view_search"/>
        <field name="arch" type="xml">
            <filter name="to_claim" position="after">
                <filter name="high_risk" string="High Rejection Risk" domain="[('risk_level', '=', 'high')]"/>
            </filter>
        </field>
    </record>

    <record id="medical_claim_form_ai" model="ir.ui.view">
        <field name="name">medical.claim.form.ai</field>
        <field name="model">medical.claim</field>
        <field name="inherit_id" ref="medical_insurance.medical_claim_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_scrub" type="object" string="Check Claims" invisible="state not in ('draft', 'submitted')"/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="alert alert-warning" role="alert" invisible="high_risk_count == 0 or state != 'draft'">
                    <field name="high_risk_count" class="fw-bold"/> lines are likely to be rejected
                    (<field name="high_risk_amount" class="fw-bold"/>). Fix them or move them out before submitting.
                    <button name="action_view_high_risk" type="object" string="Review" class="btn-link p-0 ms-2"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='claimed']" position="before">
                <field name="risk_level" optional="show" widget="badge" decoration-danger="risk_level == 'high'"
                       decoration-warning="risk_level == 'medium'" decoration-success="risk_level == 'low'"/>
                <field name="risk_reasons" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
