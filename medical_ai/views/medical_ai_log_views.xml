<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_ai_log_view_list" model="ir.ui.view">
        <field name="name">medical.ai.log.list</field>
        <field name="model">medical.ai.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'error'">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="feature"/>
                <field name="provider"/>
                <field name="model"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="prompt_chars" optional="show"/>
                <field name="response_chars" optional="show"/>
                <field name="duration"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-danger="state == 'error'"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>
    <record id="medical_ai_log_view_form" model="ir.ui.view">
        <field name="name">medical.ai.log.form</field>
        <field name="model">medical.ai.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="user_id"/>
                            <field name="feature"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="provider"/>
                            <field name="model"/>
                            <field name="duration"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <field name="error" invisible="not error"/>
                    <field name="prompt" invisible="not prompt"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_medical_ai_log" model="ir.actions.act_window">
        <field name="name">AI Request Log</field>
        <field name="res_model">medical.ai.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
