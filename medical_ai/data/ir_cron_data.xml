<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_medical_noshow" model="ir.cron">
            <field name="name">Medical AI: refresh no-show risk of upcoming visits</field>
            <field name="model_id" ref="medical_core.model_medical_visit"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_noshow_risk()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_medical_scrub" model="ir.cron">
            <field name="name">Medical AI: check claim lines waiting to be claimed</field>
            <field name="model_id" ref="medical_insurance.model_medical_claim_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_scrub_open_lines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
