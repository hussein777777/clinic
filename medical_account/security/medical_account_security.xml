<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- reception collects payments and the doctor's visit closing posts invoices -->
    <record id="medical_core.group_medical_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="medical_commission_line_company_rule" model="ir.rule">
        <field name="name">Medical commission line: multi-company</field>
        <field name="model_id" ref="model_medical_commission_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="medical_commission_rule_company_rule" model="ir.rule">
        <field name="name">Medical commission rule: multi-company</field>
        <field name="model_id" ref="model_medical_commission_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="medical_cash_closing_company_rule" model="ir.rule">
        <field name="name">Medical cash closing: multi-company</field>
        <field name="model_id" ref="model_medical_cash_closing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="medical_cash_closing_own_rule" model="ir.rule">
        <field name="name">Medical cash closing: cashiers see their own</field>
        <field name="model_id" ref="model_medical_cash_closing"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('medical_core.group_medical_user'))]"/>
    </record>
    <record id="medical_cash_closing_all_rule" model="ir.rule">
        <field name="name">Medical cash closing: accountants see all</field>
        <field name="model_id" ref="model_medical_cash_closing"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')), (4, ref('medical_core.group_medical_manager'))]"/>
    </record>
</odoo>
