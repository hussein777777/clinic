<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_category_medical_advances" model="product.category">
            <field name="name">Advances</field>
            <field name="parent_id" ref="medical_core.product_category_medical"/>
        </record>
        <record id="product_patient_advance" model="product.product">
            <field name="name">Patient Advance</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="categ_id" ref="product_category_medical_advances"/>
            <field name="list_price">0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>
        <record id="config_program_late_grace_days" model="ir.config_parameter">
            <field name="key">medical_account.program_late_grace_days</field>
            <field name="value">7</field>
        </record>
    </data>
</odoo>
