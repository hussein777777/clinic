<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_commission_wizard_view_form" model="ir.ui.view">
        <field name="name">medical.commission.wizard.form</field>
        <field name="model">medical.commission.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="doctor_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_medical_commission_wizard" model="ir.actions.act_window">
        <field name="name">Compute Commissions</field>
        <field name="res_model">medical.commission.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
