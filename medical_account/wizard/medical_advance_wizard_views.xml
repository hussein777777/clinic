<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_advance_wizard_view_form" model="ir.ui.view">
        <field name="name">medical.advance.wizard.form</field>
        <field name="model">medical.advance.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>An advance invoice is posted to the patient advances account and kept for this plan.
                   It is deducted automatically from the next patient invoices of the plan.</p>
                <group>
                    <field name="plan_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create &amp; Collect" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
