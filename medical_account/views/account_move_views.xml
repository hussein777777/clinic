<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_medical" model="ir.ui.view">
        <field name="name">account.move.form.medical</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@name='sale_info_group']" position="inside">
                <field name="medical_move_kind" readonly="1" invisible="not medical_move_kind"/>
                <field name="medical_visit_id" readonly="1" invisible="not medical_visit_id"/>
                <field name="medical_claim_id" readonly="1" invisible="not medical_claim_id"/>
                <field name="care_contract_id" readonly="1" invisible="not care_contract_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_medical_patient_invoices" model="ir.actions.act_window">
        <field name="name">Patient Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('medical_move_kind', 'in', ('patient', 'advance', 'rebill', 'program_contract', 'program_termination'))]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
    </record>
    <record id="action_medical_insurer_invoices" model="ir.actions.act_window">
        <field name="name">Insurer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('medical_move_kind', 'in', ('insurer', 'insurer_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
    </record>
    <record id="action_medical_doctor_analytic" model="ir.actions.act_window">
        <field name="name">Doctor Profitability</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('medical_doctor_id', '!=', False), ('parent_state', '=', 'posted'), ('display_type', '=', 'product')]</field>
        <field name="context">{'pivot_row_groupby': ['medical_doctor_id'], 'pivot_column_groupby': ['account_id'], 'pivot_measures': ['balance']}</field>
    </record>
</odoo>
