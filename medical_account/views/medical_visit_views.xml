<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_visit_form_account" model="ir.ui.view">
        <field name="name">medical.visit.form.account</field>
        <field name="model">medical.visit</field>
        <field name="inherit_id" ref="medical_core.medical_visit_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="payment_state" invisible="1"/>
                <button name="action_register_payment" type="object" string="Collect Payment" class="btn-primary"
                        invisible="state != 'invoiced' or not patient_move_id or payment_state in ('paid', 'in_payment', 'reversed')"/>
                <button name="action_reverse_invoice" type="object" string="Reverse Invoice" groups="medical_core.group_medical_manager"
                        invisible="state != 'invoiced'" confirm="Credit the patient invoice and re-open the visit for correction?"/>
                <button name="action_reinvoice" type="object" string="Invoice" class="btn-primary"
                        invisible="state != 'done'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_patient_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not patient_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Invoice</span>
                        <field name="payment_state" readonly="1" class="o_stat_value"/>
                    </div>
                </button>
            </div>
            <group name="totals" position="inside">
                <field name="patient_move_id" invisible="1"/>
                <field name="amount_due" invisible="not patient_move_id"/>
            </group>
        </field>
    </record>

    <record id="medical_visit_list_account" model="ir.ui.view">
        <field name="name">medical.visit.list.account</field>
        <field name="model">medical.visit</field>
        <field name="inherit_id" ref="medical_core.medical_visit_view_list"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="after">
                <field name="amount_due" optional="show" sum="Due"/>
                <field name="payment_state" optional="show" widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment')" decoration-danger="payment_state == 'not_paid'"/>
            </field>
        </field>
    </record>

    <record id="medical_visit_search_account" model="ir.ui.view">
        <field name="name">medical.visit.search.account</field>
        <field name="model">medical.visit</field>
        <field name="inherit_id" ref="medical_core.medical_visit_view_search"/>
        <field name="arch" type="xml">
            <filter name="to_invoice" position="after">
                <filter name="to_collect" string="Waiting for Payment"
                        domain="[('state', '=', 'invoiced'), ('patient_move_id.payment_state', 'in', ('not_paid', 'partial'))]"/>
            </filter>
        </field>
    </record>

    <record id="action_medical_visit_to_collect" model="ir.actions.act_window">
        <field name="name">Waiting for Payment</field>
        <field name="res_model">medical.visit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_collect': 1}</field>
    </record>

    <record id="medical_plan_form_account" model="ir.ui.view">
        <field name="name">medical.treatment.plan.form.account</field>
        <field name="model">medical.treatment.plan</field>
        <field name="inherit_id" ref="medical_core.medical_treatment_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_advance_wizard" type="object" string="Receive Advance"
                        invisible="state not in ('accepted', 'in_progress')"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_advance_invoices" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="advance_invoice_count == 0">
                    <field name="advance_invoice_count" widget="statinfo" string="Advances"/>
                </button>
            </div>
            <group name="totals" position="inside">
                <field name="advance_balance" invisible="advance_balance == 0"/>
            </group>
        </field>
    </record>
</odoo>
