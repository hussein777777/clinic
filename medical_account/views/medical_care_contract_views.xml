<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_care_contract_form_account" model="ir.ui.view">
        <field name="name">medical.care.contract.form.account</field>
        <field name="model">medical.care.contract</field>
        <field name="inherit_id" ref="medical_core.medical_care_contract_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_contract_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not contract_move_id">
                    <span class="o_stat_text">Contract</span>
                </button>
                <button name="action_view_entries" type="object" class="oe_stat_button" icon="fa-book"
                        invisible="not contract_move_id" groups="account.group_account_invoice">
                    <span class="o_stat_text">Entries</span>
                </button>
            </div>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Installments late" bg_color="text-bg-danger" invisible="not is_late"/>
            </xpath>
            <group name="progress" position="after">
                <group string="Accounting" name="accounting" invisible="not contract_move_id">
                    <field name="contract_move_id" invisible="1"/>
                    <field name="is_late" invisible="1"/>
                    <field name="amount_paid"/>
                    <field name="overdue_amount" decoration-danger="overdue_amount &gt; 0"/>
                    <field name="recognized_months" invisible="billing_mode != 'monthly'"/>
                    <field name="recognized_amount"/>
                    <field name="deferred_balance"/>
                </group>
            </group>
        </field>
    </record>

    <record id="medical_care_contract_list_account" model="ir.ui.view">
        <field name="name">medical.care.contract.list.account</field>
        <field name="model">medical.care.contract</field>
        <field name="inherit_id" ref="medical_core.medical_care_contract_view_list"/>
        <field name="arch" type="xml">
            <field name="package_price" position="after">
                <field name="overdue_amount" optional="show"/>
            </field>
        </field>
    </record>

    <record id="medical_care_contract_search_account" model="ir.ui.view">
        <field name="name">medical.care.contract.search.account</field>
        <field name="model">medical.care.contract</field>
        <field name="inherit_id" ref="medical_core.medical_care_contract_view_search"/>
        <field name="arch" type="xml">
            <filter name="running" position="after">
                <filter name="late" string="Installments Late" domain="[('is_late', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
