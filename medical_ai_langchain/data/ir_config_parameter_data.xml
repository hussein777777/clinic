<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="config_ai_engine" model="ir.config_parameter">
            <field name="key">medical_ai.engine</field>
            <field name="value">langchain</field>
        </record>
        <record id="config_ai_embedding_provider" model="ir.config_parameter">
            <field name="key">medical_ai.embedding_provider</field>
            <field name="value">local</field>
        </record>
        <record id="cron_index_knowledge" model="ir.cron">
            <field name="name">Medical AI: index new knowledge-base documents</field>
            <field name="model_id" ref="model_medical_ai_kb_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_index_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
