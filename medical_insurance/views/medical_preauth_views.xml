<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_preauth_view_form" model="ir.ui.view">
        <field name="name">medical.preauth.form</field>
        <field name="model">medical.preauth</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Mark as Sent" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="%(action_report_medical_preauth)d" type="action" string="Print Request" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_record_response" type="object" string="Record Insurer Response" class="btn-primary"
                            invisible="state not in ('draft', 'sent')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled',)"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('cancelled', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_id" readonly="state != 'draft'"/>
                            <field name="patient_id"/>
                            <field name="insurer_id"/>
                            <field name="member_no"/>
                            <field name="plan_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="response_date"/>
                            <field name="approval_no" readonly="state not in ('draft', 'sent')"/>
                            <field name="expiry_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state not in ('draft', 'sent')">
                        <list editable="bottom" create="0">
                            <field name="treatment_line_id" readonly="1"/>
                            <field name="insurance_code"/>
                            <field name="site_label"/>
                            <field name="requested_amount"/>
                            <field name="approved_amount"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="requested_amount"/>
                        <field name="approved_amount"/>
                    </group>
                    <field name="note" placeholder="Insurer remarks..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_preauth_view_list" model="ir.ui.view">
        <field name="name">medical.preauth.list</field>
        <field name="model">medical.preauth</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_date"/>
                <field name="patient_id"/>
                <field name="insurer_id"/>
                <field name="approval_no"/>
                <field name="requested_amount" sum="Total"/>
                <field name="approved_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="expiry_date" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state in ('sent', 'partial')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="medical_preauth_view_search" model="ir.ui.view">
        <field name="name">medical.preauth.search</field>
        <field name="model">medical.preauth</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurer_id"/>
                <field name="approval_no"/>
                <filter name="waiting" string="Waiting for Insurer" domain="[('state', 'in', ('draft', 'sent'))]"/>
                <group>
                    <filter name="group_insurer" string="Insurer" context="{'group_by': 'insurer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medical_preauth" model="ir.actions.act_window">
        <field name="name">Pre-authorizations</field>
        <field name="res_model">medical.preauth</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_waiting': 1}</field>
    </record>
</odoo>
