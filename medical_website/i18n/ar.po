#. module: medical_website
#: model:mail.template,body_html:medical_website.mail_template_booking_received
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6;\">\n"
"    <p>Hello <t t-out=\"object.booking_name or object.patient_id.name or ''\"/>,</p>\n"
"    <p>We received your booking at <strong t-out=\"object.company_id.name or ''\"/>:</p>\n"
"    <p style=\"font-size: 18px;\">\n"
"        <strong t-out=\"format_datetime(object.start, tz=object.doctor_id.tz, dt_format='EEEE d MMMM y, HH:mm') or ''\"/><br/>\n"
"        <t t-out=\"object.doctor_id.name or ''\"/>, <t t-out=\"object.department_id.name or ''\"/>\n"
"    </p>\n"
"    <p t-if=\"object.state == 'confirmed'\">Your appointment is confirmed. Please come 10 minutes early.</p>\n"
"    <p t-else=\"\">The clinic will call you or message you on WhatsApp to confirm.</p>\n"
"    <p>To check or cancel the appointment, open your booking page:<br/>\n"
"        <a t-att-href=\"'%s/appointment/booking/%s' % (object.get_base_url(), object.sudo().booking_token)\">Your booking page</a></p>\n"
"    <p>Booking number: <t t-out=\"object.name or ''\"/></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6;\" dir=\"rtl\">\n"
"    <p>مرحبًا <t t-out=\"object.booking_name or object.patient_id.name or ''\"/>،</p>\n"
"    <p>استلمنا حجزك في <strong t-out=\"object.company_id.name or ''\"/>:</p>\n"
"    <p style=\"font-size: 18px;\">\n"
"        <strong t-out=\"format_datetime(object.start, tz=object.doctor_id.tz, dt_format='EEEE d MMMM y, HH:mm') or ''\"/><br/>\n"
"        <t t-out=\"object.doctor_id.name or ''\"/>، <t t-out=\"object.department_id.name or ''\"/>\n"
"    </p>\n"
"    <p t-if=\"object.state == 'confirmed'\">تم تأكيد موعدك. من فضلك احضر قبل الموعد بعشر دقائق.</p>\n"
"    <p t-else=\"\">ستتصل بك العيادة أو تراسلك على واتساب لتأكيد الموعد.</p>\n"
"    <p>لمراجعة الموعد أو إلغائه افتح صفحة حجزك:<br/>\n"
"        <a t-att-href=\"'%s/appointment/booking/%s' % (object.get_base_url(), object.sudo().booking_token)\">صفحة حجزك</a></p>\n"
"    <p>رقم الحجز: <t t-out=\"object.name or ''\"/></p>\n"
"</div>\n"
"            "

