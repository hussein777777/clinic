        <record id="obs_itch_nrs" model="medical.observation.type">
            <field name="name">Itch Intensity</field>
            <field name="code">itch_nrs</field>
            <field name="unit">/10</field>
            <field name="category">score</field>
            <field name="normal_min">0</field>
            <field name="normal_max">3</field>
            <field name="critical_min">0</field>
            <field name="critical_max">0</field>
            <field name="decimals">0</field>
            <field name="lower_is_better" eval="True"/>
            <field name="sequence">97</field>
            <field name="department_ids" eval="[(4, ref('dept_dermatology'))]"/>
        </record>
        <record id="obs_acne_iga" model="medical.observation.type">
            <field name="name">Acne Severity (global grade)</field>
            <field name="code">acne_iga</field>
            <field name="unit">/4</field>
            <field name="category">score</field>
            <field name="normal_min">0</field>
            <field name="normal_max">1</field>
            <field name="critical_min">0</field>
            <field name="critical_max">0</field>
            <field name="decimals">0</field>
            <field name="lower_is_better" eval="True"/>
            <field name="sequence">98</field>
            <field name="department_ids" eval="[(4, ref('dept_dermatology'))]"/>
        </record>
        <record id="score_itch_nrs" model="medical.assessment.template">
            <field name="name">Itch Numeric Rating Scale</field>
            <field name="code">ITCH_NRS</field>
            <field name="score_mode">sum</field>
            <field name="department_ids" eval="[(4, ref('dept_dermatology'))]"/>
            <field name="item_ids" eval="[(0, 0, {'sequence': 1, 'name': 'Worst itch in the last 24 hours (0 = none, 10 = worst imaginable)', 'section': False, 'answer_type': 'number', 'min_value': 0, 'max_value': 10})]"/>
            <field name="range_ids" eval="[(0, 0, {'min_score': 0, 'max_score': 0, 'name': 'No itch', 'severity': 'none'}), (0, 0, {'min_score': 0.01, 'max_score': 3.99, 'name': 'Mild itch', 'severity': 'mild'}), (0, 0, {'min_score': 4, 'max_score': 6.99, 'name': 'Moderate itch', 'severity': 'moderate'}), (0, 0, {'min_score': 7, 'max_score': 8.99, 'name': 'Severe itch', 'severity': 'severe'}), (0, 0, {'min_score': 9, 'max_score': 10, 'name': 'Very severe itch', 'severity': 'severe'})]"/>
            <field name="observation_type_id" ref="obs_itch_nrs"/>
        </record>
        <record id="score_acne_iga" model="medical.assessment.template">
            <field name="name">Acne Global Severity</field>
            <field name="code">ACNE_IGA</field>
            <field name="score_mode">sum</field>
            <field name="department_ids" eval="[(4, ref('dept_dermatology'))]"/>
            <field name="item_ids" eval="[(0, 0, {'sequence': 1, 'name': 'Overall severity', 'section': False, 'option_ids': [(0, 0, {'sequence': 1, 'name': 'Clear', 'score': 0, 'is_alert': False}), (0, 0, {'sequence': 2, 'name': 'Almost clear', 'score': 1, 'is_alert': False}), (0, 0, {'sequence': 3, 'name': 'Mild', 'score': 2, 'is_alert': False}), (0, 0, {'sequence': 4, 'name': 'Moderate', 'score': 3, 'is_alert': False}), (0, 0, {'sequence': 5, 'name': 'Severe', 'score': 4, 'is_alert': False})]})]"/>
            <field name="range_ids" eval="[(0, 0, {'min_score': 0, 'max_score': 1, 'name': 'Clear or almost clear', 'severity': 'none'}), (0, 0, {'min_score': 2, 'max_score': 2, 'name': 'Mild', 'severity': 'mild'}), (0, 0, {'min_score': 3, 'max_score': 3, 'name': 'Moderate', 'severity': 'moderate'}), (0, 0, {'min_score': 4, 'max_score': 4, 'name': 'Severe', 'severity': 'severe'})]"/>
            <field name="observation_type_id" ref="obs_acne_iga"/>
        </record>
