<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_visit_add_lines_view_form" model="ir.ui.view">
        <field name="name">medical.visit.add.lines.form</field>
        <field name="model">medical.visit.add.lines</field>
        <field name="arch" type="xml">
            <form>
                <field name="visit_id" invisible="1"/>
                <field name="patient_id" invisible="1"/>
                <field name="line_ids" widget="many2many" options="{'no_create': True}">
                    <list>
                        <field name="plan_id"/>
                        <field name="product_id"/>
                        <field name="site_label"/>
                        <field name="price_subtotal"/>
                        <field name="currency_id" column_invisible="True"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Add to Visit" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
