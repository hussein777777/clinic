<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_treatment_plan_view_form" model="ir.ui.view">
        <field name="name">medical.treatment.plan.form</field>
        <field name="model">medical.treatment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_present" type="object" string="Present to Patient" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_accept" type="object" string="Patient Accepted" class="btn-primary"
                            invisible="state != 'presented'"/>
                    <button name="action_draft" type="object" string="Back to Draft"
                            invisible="state not in ('presented', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,presented,accepted,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group name="main">
                        <group>
                            <field name="patient_id" readonly="state not in ('draft', 'presented')"/>
                            <field name="doctor_id"/>
                            <field name="department_id"/>
                        </group>
                        <group name="dates">
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Treatments" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancelled')"
                                   context="{'default_patient_id': patient_id, 'default_doctor_id': doctor_id}">
                                <list editable="bottom" decoration-muted="state == 'cancelled'" decoration-success="state == 'executed'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" readonly="state == 'executed'"/>
                                    <field name="body_site_id" optional="show" readonly="state == 'executed'"/>
                                    <field name="laterality" optional="show" readonly="state == 'executed'"/>
                                    <field name="doctor_id" optional="show"/>
                                    <field name="patient_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="price_unit" readonly="state == 'executed'"/>
                                    <field name="discount" optional="show" readonly="state == 'executed'"/>
                                    <field name="price_subtotal"/>
                                    <field name="visit_id" optional="show" readonly="1"/>
                                    <field name="state" widget="badge" decoration-info="state == 'scheduled'"
                                           decoration-success="state == 'executed'"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="totals">
                                <field name="amount_total"/>
                                <field name="amount_executed"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="medical_treatment_plan_view_list" model="ir.ui.view">
        <field name="name">medical.treatment.plan.list</field>
        <field name="model">medical.treatment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="department_id" optional="show"/>
                <field name="doctor_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('accepted', 'in_progress')"/>
            </list>
        </field>
    </record>

    <record id="medical_treatment_plan_view_search" model="ir.ui.view">
        <field name="name">medical.treatment.plan.search</field>
        <field name="model">medical.treatment.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="department_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('presented', 'accepted', 'in_progress'))]"/>
                <filter name="accepted_pending" string="Accepted, not started"
                        domain="[('state', '=', 'accepted')]"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medical_treatment_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">medical.treatment.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
