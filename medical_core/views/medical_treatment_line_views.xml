<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_treatment_line_view_list" model="ir.ui.view">
        <field name="name">medical.treatment.line.list</field>
        <field name="model">medical.treatment.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'cancelled'" decoration-success="state == 'executed'">
                <field name="patient_id"/>
                <field name="plan_id" optional="show"/>
                <field name="visit_id" optional="show"/>
                <field name="doctor_id"/>
                <field name="product_id"/>
                <field name="site_label"/>
                <field name="department_id" optional="show"/>
                <field name="specialty_id" optional="hide"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="date_executed" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'scheduled'" decoration-success="state == 'executed'"/>
            </list>
        </field>
    </record>

    <record id="medical_treatment_line_view_form" model="ir.ui.view">
        <field name="name">medical.treatment.line.form</field>
        <field name="model">medical.treatment.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_execute" type="object" string="Execute" class="btn-primary"
                            invisible="state not in ('planned', 'scheduled')" groups="medical_core.group_medical_doctor"/>
                    <button name="action_consent" type="object" string="Consent" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('planned', 'scheduled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,scheduled,executed"/>
                </header>
                <sheet>
                    <group name="main">
                        <group>
                            <field name="patient_id"/>
                            <field name="plan_id"/>
                            <field name="visit_id"/>
                            <field name="doctor_id"/>
                            <field name="care_contract_id"/>
                        </group>
                        <group name="procedure">
                            <field name="product_id"/>
                            <field name="body_site_id"/>
                            <field name="laterality"/>
                            <field name="consent_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="price_subtotal"/>
                            <field name="date_executed"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medical_treatment_line_view_search" model="ir.ui.view">
        <field name="name">medical.treatment.line.search</field>
        <field name="model">medical.treatment.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="product_id"/>
                <field name="doctor_id"/>
                <field name="department_id"/>
                <field name="site_label"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('planned', 'scheduled'))]"/>
                <filter name="executed" string="Executed" domain="[('state', '=', 'executed')]"/>
                <separator/>
                <filter name="date_executed" string="Executed On" date="date_executed"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_specialty" string="Specialty" context="{'group_by': 'specialty_id'}"/>
                    <filter name="group_product" string="Procedure" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="medical_treatment_line_view_pivot" model="ir.ui.view">
        <field name="name">medical.treatment.line.pivot</field>
        <field name="model">medical.treatment.line</field>
        <field name="arch" type="xml">
            <pivot string="Treatments">
                <field name="doctor_id" type="row"/>
                <field name="department_id" type="col"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_medical_treatment_line" model="ir.actions.act_window">
        <field name="name">Treatments</field>
        <field name="res_model">medical.treatment.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_medical_treatment_line_analysis" model="ir.actions.act_window">
        <field name="name">Treatments Analysis</field>
        <field name="res_model">medical.treatment.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_executed': 1}</field>
    </record>
</odoo>
