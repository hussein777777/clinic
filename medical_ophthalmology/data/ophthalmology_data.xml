            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">procedure</field>
            <field name="specialty_id" ref="spec_eye_general"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">800</field>
            <field name="insurance_code">OPH-CHAL</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">side</field>
        </record>
