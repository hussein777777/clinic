        <record id="dept_ophthalmology" model="medical.department">
            <field name="name">Ophthalmology</field>
            <field name="code">OPH</field>
            <field name="sequence">45</field>
            <field name="color">7</field>
        </record>
        <record id="spec_eye_general" model="medical.specialty">
            <field name="name">General Ophthalmology</field>
            <field name="code">OPH-GEN</field>
            <field name="department_id" ref="dept_ophthalmology"/>
