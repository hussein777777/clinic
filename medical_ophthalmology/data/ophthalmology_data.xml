        <record id="obs_iop" model="medical.observation.type">
            <field name="name">Intraocular Pressure</field>
            <field name="code">iop</field>
            <field name="unit">mmHg</field>
            <field name="category">exam</field>
            <field name="normal_min">10</field>
            <field name="normal_max">21</field>
            <field name="critical_min">0</field>
            <field name="critical_max">30</field>
            <field name="decimals">0</field>
            <field name="lower_is_better" eval="True"/>
