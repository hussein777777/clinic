            <field name="insurance_code">OPH-OCT</field>
            <field name="procedure_duration">15</field>
            <field name="site_requirement">side</field>
        </record>
        <record id="product_visual_field" model="product.product">
            <field name="name">Visual Field Test</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">test</field>
            <field name="specialty_id" ref="spec_eye_glaucoma"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">400</field>
            <field name="insurance_code">OPH-VF</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">side</field>
        </record>
        <record id="product_fundus_photo" model="product.product">
            <field name="name">Fundus Photography</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">test</field>
            <field name="specialty_id" ref="spec_eye_retina"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">300</field>
            <field name="insurance_code">OPH-FP</field>
            <field name="procedure_duration">10</field>
            <field name="site_requirement">side</field>
        </record>
        <record id="product_biometry" model="product.product">
            <field name="name">Optical Biometry (IOL calculation)</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">test</field>
            <field name="specialty_id" ref="spec_eye_cataract"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">500</field>
            <field name="insurance_code">OPH-BIO</field>
            <field name="procedure_duration">15</field>
            <field name="site_requirement">side</field>
        </record>
        <record id="product_yag" model="product.product">
            <field name="name">YAG Laser Capsulotomy</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">procedure</field>
            <field name="specialty_id" ref="spec_eye_cataract"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">1200</field>
            <field name="insurance_code">OPH-YAG</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">side</field>
            <field name="requires_consent" eval="True"/>
            <field name="consent_text" type="html"><p>I agree to the laser treatment of the eye shown on this form. The doctor explained the purpose and the possible effects: temporary blurred vision, glare, a short rise in eye pressure and, rarely, inflammation or worsened vision.</p></field>
        </record>
        <record id="product_slt" model="product.product">
            <field name="name">Selective Laser Trabeculoplasty (SLT)</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">procedure</field>
            <field name="specialty_id" ref="spec_eye_glaucoma"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">2000</field>
            <field name="insurance_code">OPH-SLT</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">side</field>
            <field name="requires_consent" eval="True"/>
            <field name="consent_text" type="html"><p>I agree to the laser treatment of the eye shown on this form. The doctor explained the purpose and the possible effects: temporary blurred vision, glare, a short rise in eye pressure and, rarely, inflammation or worsened vision.</p></field>
        </record>
        <record id="product_prp" model="product.product">
            <field name="name">Panretinal Laser Photocoagulation</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">procedure</field>
            <field name="specialty_id" ref="spec_eye_retina"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">1800</field>
            <field name="insurance_code">OPH-PRP</field>
            <field name="procedure_duration">30</field>
            <field name="site_requirement">side</field>
            <field name="requires_consent" eval="True"/>
            <field name="consent_text" type="html"><p>I agree to the laser treatment of the eye shown on this form. The doctor explained the purpose and the possible effects: temporary blurred vision, glare, a short rise in eye pressure and, rarely, inflammation or worsened vision.</p></field>
        </record>
        <record id="product_ivi" model="product.product">
            <field name="name">Intravitreal Anti-VEGF Injection</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">procedure</field>
            <field name="specialty_id" ref="spec_eye_retina"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">3500</field>
            <field name="insurance_code">OPH-IVI</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">side</field>
            <field name="requires_consent" eval="True"/>
            <field name="consent_text" type="html"><p>I agree to an injection into the eye. Possible risks were explained: redness and discomfort, floaters, raised eye pressure, and rarely infection inside the eye (endophthalmitis) or retinal detachment, which need urgent care. I will come back at once for pain or reduced vision.</p></field>
        </record>
        <record id="product_phaco" model="product.product">
            <field name="name">Phacoemulsification with IOL</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">surgery</field>
            <field name="specialty_id" ref="spec_eye_cataract"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">12000</field>
            <field name="insurance_code">OPH-PHACO</field>
            <field name="procedure_duration">45</field>
            <field name="site_requirement">side</field>
            <field name="requires_consent" eval="True"/>
            <field name="consent_text" type="html"><p>I agree to cataract surgery with lens implant on the eye shown on this form. The surgeon explained the expected result, the need for glasses for some tasks after surgery, and the possible risks: inflammation, raised eye pressure, posterior capsule opacification, infection, retinal detachment and, rarely, loss of vision.</p></field>
        </record>
        <record id="product_pterygium" model="product.product">
            <field name="name">Pterygium Excision</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">surgery</field>
            <field name="specialty_id" ref="spec_eye_general"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">4000</field>
            <field name="insurance_code">OPH-PTER</field>
            <field name="procedure_duration">40</field>
            <field name="site_requirement">side</field>
            <field name="requires_consent" eval="True"/>
            <field name="consent_text" type="html"><p>I agree to pterygium excision on the eye shown on this form. The surgeon explained the expected result, the need for glasses for some tasks after surgery, and the possible risks: inflammation, raised eye pressure, posterior capsule opacification, infection, retinal detachment and, rarely, loss of vision.</p></field>
        </record>
        <record id="product_chalazion" model="product.product">
