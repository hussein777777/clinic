        <record id="product_eye_consultation" model="product.product">
            <field name="name">Ophthalmology Consultation</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">consultation</field>
            <field name="specialty_id" ref="spec_eye_general"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">300</field>
            <field name="insurance_code">OPH-CONS</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">none</field>
        </record>
        <record id="product_refraction" model="product.product">
            <field name="name">Refraction &amp; Glasses Prescription</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">procedure</field>
            <field name="specialty_id" ref="spec_eye_optometry"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
            <field name="list_price">150</field>
            <field name="insurance_code">OPH-REFR</field>
            <field name="procedure_duration">20</field>
            <field name="site_requirement">none</field>
        </record>
        <record id="product_oct" model="product.product">
            <field name="name">OCT (Optical Coherence Tomography)</field>
            <field name="type">service</field>
            <field name="is_medical_procedure" eval="True"/>
            <field name="procedure_type">test</field>
            <field name="specialty_id" ref="spec_eye_retina"/>
            <field name="categ_id" ref="medical_core.product_category_medical"/>
