            <field name="code">medical.eye.prescription</field>
            <field name="prefix">GRX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="medicine_latanoprost" model="product.product">
            <field name="name">Latanoprost 0.005% Eye Drops</field>
            <field name="type">consu</field>
            <field name="is_medicine" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="active_ingredient">Latanoprost</field>
            <field name="strength">0.005%</field>
            <field name="dosage_form">drops</field>
            <field name="default_route">eye</field>
        </record>
        <record id="medicine_artificial_tears" model="product.product">
